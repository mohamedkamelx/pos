    "icon-gen": "^5.0.0",
    "jquery": "^3.7.1",
    "js-yaml": "^4.3.2",
    "jsdom": "30.1.1",
    "lint-staged": "^17.6.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "@opencode/sdk": "2.4.1",
    "electron-updater": "^6.8.9",
    "mongodb": "7.7.0",
    "pdf-to-printer": "^5.8.1",
    "redis": "^6.4.0",
    "serialport": "^13.0.0"
  },
  "overrides": {
    "sharp": "$sharp",
    "js-yaml": "^4.3.2"
  },
  "keywords": [
    "pos",
    "open-source-pos",
    "offline-pos",
    "point-of-sale",
    "point-of-sale-system",
    "pos-software",
    "electron",
    "offline-first",
    "open-source",
    "retail",
    "inventory-management",
    "billing-software",
